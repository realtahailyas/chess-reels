# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit real secrets. See the "One-time account setup" section of the
# publishing plan for how to obtain each of these.

# --- Meta (Facebook Page + Instagram Business account) ---
# System User token from Business Settings -> System Users, with
# pages_manage_posts, pages_read_engagement, instagram_basic,
# instagram_content_publish. This token does NOT expire (unlike a personal
# Page token, which dies in ~60 days) — required for unattended posting.
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
FB_GRAPH_API_VERSION=v26.0

# --- GitHub (temporary public host for Instagram's required video_url) ---
# A public repo dedicated to this, e.g. "yourname/chessreel-cdn".
# Fine-grained PAT scoped to just "contents: write" on that one repo.
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main

# --- YouTube ---
# Google Cloud project with YouTube Data API v3 enabled, OAuth client
# (Desktop app type) downloaded as client_secret.json. YT_TOKEN_PATH is
# where the refresh token gets saved after the one-time interactive consent
# (run `python publish.py --once <id>` once manually so the browser flow can
# open) — after that, publish.py never needs a browser again.
#
# IMPORTANT: get the OAuth consent screen verified (Google App Verification)
# before relying on unattended runs. Left in "Testing" status, refresh
# tokens for the youtube.upload scope silently die after 7 days.
YT_CLIENT_SECRET_PATH=./client_secret.json
YT_TOKEN_PATH=./data/youtube_token.json

# ── TikTok (draft / inbox upload) ────────────────────────────────────────────
# 🔴 TIKTOK_ENABLED IS OFF UNLESS SET. Turning it on makes every already-queued
# entry due for TikTok too, so the publisher will trickle the whole backlog into
# the inbox at one per run. Prove the upload works first, then decide.
TIKTOK_ENABLED=
# From the TikTok developer portal, App details -> Credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# EXACTLY the redirect URI registered on the app (Sandbox -> Redirect URI).
# It does not have to be a page that loads — `python -m src.tiktok auth` asks
# you to paste the redirected URL back, so an unroutable URI works fine.
TIKTOK_REDIRECT_URI=
# Where the access/refresh tokens are cached. Keep it out of the repo, next to
# the other credentials. Access tokens last 24h and refresh for 365 days, so
# once this exists the publisher never needs a human again.
TIKTOK_TOKEN_PATH=data/tiktok_token.json

# ── Second brand: @tchessapp (Instagram) + "TChess App" (YouTube) ────────────
# Two brands publish from this one pipeline and NEVER share a reel: each built
# reel is stamped with one account the first time a run claims it (see
# config.ACCOUNTS and src/queue.py:assign_account). Everything about the
# content is shared — caption engine, hashtags, YouTube title shape, pinned
# first comment, watermark — only the destination and the clock differ.
#
# Instagram: @tchessapp is an asset in the same "Taha Pages" Business
# portfolio as @tahachesstv, so ONE System User token covers both. It must
# still be ASSIGNED to the "ChessReel Publisher" System User in Business
# Manager — until it is, the Graph API answers "object does not exist" for it.
# Check with: python scripts/verify_accounts.py tchessapp
IG_USER_ID_TCHESSAPP=
# Optional. Leave unset to reuse FB_PAGE_TOKEN (the normal case).
FB_PAGE_TOKEN_TCHESSAPP=

# YouTube: a SEPARATE token file, and this is not optional. Both channels sit
# behind one Google login, but an OAuth credential is bound to whichever
# channel is picked in the consent screen's channel chooser and videos.insert
# cannot override it — pointing this at YT_TOKEN_PATH would upload every
# @tchessapp reel to Taha Chess TV.
#   Mint it with: python scripts/yt_auth_account.py tchessapp
YT_TOKEN_PATH_TCHESSAPP=./data/youtube_token_tchessapp.json
# Printed by that script. Pins the channel so a later re-consent that lands on
# the wrong one is refused instead of published.
YT_CHANNEL_ID_TCHESSAPP=

# Same pin for the original brand. Optional, and unset historically — that
# account has uploaded to the right channel since day one and must not start
# depending on a new required variable.
YT_CHANNEL_ID=

# 🔴 OFF UNTIL PROVEN, like TIKTOK_ENABLED and for the same reason: a new
# publishing target must never go live just because code shipped. Set to 1
# only once `python scripts/verify_accounts.py tchessapp` passes, then
# register its slots with scripts/setup_tchessapp_schedule.ps1.
TCHESSAPP_ENABLED=

# ---------------------------------------------------------------------------
# Added for the public release: every id/handle the code reads from the
# environment. All values here are placeholders.
# ---------------------------------------------------------------------------

# Facebook Page id for the second account (tchessapp).
FB_PAGE_ID_TCHESSAPP=
# Meta Business portfolio id, used by the Business Suite reels composer
# (browser/MetaReelPublisher.js). Find it in the composer URL: ...&business_id=<this>
META_BUSINESS_ID=

# Status repo the dashboard reads (private repo, Contents read/write PAT).
GITHUB_STATUS_REPO=your-user/chessreel-status
GITHUB_STATUS_BRANCH=main
GITHUB_STATUS_TOKEN=

# Captions (optional). Unset falls back to template captions.
OPENAI_API_KEY=
OPENAI_MODEL=

# Feature flags / browser publishers.
FACEBOOK_ENABLED=
BROWSER_DRY_RUN=1
BROWSER_HEADLESS=
CHROME_PROFILE_DIR=
TIKTOK_DRY_RUN=1
TIKTOK_PROFILE_DIR=

# Chrome profile used by another project on this machine; chess-reels refuses
# to launch Chrome on it (safety check). Optional.
JARVIS_PROFILE_DIR=
